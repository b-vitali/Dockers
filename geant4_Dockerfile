FROM ubuntu:22.04

LABEL author="Geant4 collaboration"
LABEL version="Geant4-OpenGL"

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Etc/UTC

# --- Geant4 environment ---
ENV G4INSTALL=/opt/geant4
ENV G4DATA_DIR=/opt/geant4/share/Geant4/data
ENV G4LIB_DIR=/opt/geant4/lib
ENV PATH=/opt/geant4/bin:$PATH
ENV LD_LIBRARY_PATH=/opt/geant4/lib
ENV G4GDMLROOT=/opt/geant4

# --- Base utilities (cached early) ---
RUN apt-get update && apt-get install -y \
    python3-pip \
    python3-dev \
    python3-tk \
    git \
    sudo \
    libsqlite3-dev \
    screen \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --- Build dependencies ---
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    wget \
    libxerces-c-dev \
    libexpat1-dev \
    libgl1-mesa-dev \
    libglu1-mesa-dev \
    freeglut3-dev \
    mesa-common-dev \
    libx11-dev \
    libxmu-dev \    
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --- Download source (cached separately) ---
WORKDIR /opt
RUN G4_VERSION=11.4.0 && \
    wget https://github.com/Geant4/geant4/archive/refs/tags/v${G4_VERSION}.tar.gz && \
    tar -xf v${G4_VERSION}.tar.gz && \
    mv geant4-${G4_VERSION} geant4-source

# --- Configure (separate layer for cache) ---
RUN mkdir /opt/geant4-build
WORKDIR /opt/geant4-build

RUN cmake ../geant4-source \
    -DCMAKE_INSTALL_PREFIX=/opt/geant4 \
    -DGEANT4_BUILD_MULTITHREADED=ON \
    -DGEANT4_USE_GDML=ON \
    -DGEANT4_USE_SYSTEM_EXPAT=ON \
    -DGEANT4_USE_SYSTEM_XERCESC=ON \
    -DGEANT4_INSTALL_DATA=ON \
    -DGEANT4_INSTALL_EXAMPLES=ON \
    -DGEANT4_USE_OPENGL_X11=ON \
    -DGEANT4_USE_QT=OFF \
    -DGEANT4_USE_XM=OFF \
    -DGEANT4_USE_RAYTRACER_X11=OFF

# --- Build (separate so failures don't kill previous cache) ---
RUN make -j$(nproc)

# --- Install (separate layer) ---
RUN make install

# --- Cleanup (optional but good) ---
RUN rm -rf /opt/geant4-source /opt/geant4-build /opt/v11.4.0.tar.gz

# --- Python packages ---
RUN pip3 install --no-cache-dir numpy scipy pandas matplotlib

# --- X11 runtime ---
ENV DISPLAY=:0

# --- User setup ---
ARG USER_ID=1000
ARG GROUP_ID=1000

RUN groupadd --gid ${GROUP_ID} usergroup && \
    useradd --uid ${USER_ID} --gid ${GROUP_ID} -m user && \
    echo "user ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER user

# --- Shell setup ---
RUN echo 'export CUSTOM_NAME="geant4"' >> /home/user/.bashrc
RUN echo 'echo -ne "\033]0;Geant4\007"' >> /home/user/.bashrc
RUN echo 'if [[ $STY ]]; then export PS1="\[\033[01;32m\]${CUSTOM_NAME}_$STY\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ "; else export PS1="\[\033[01;32m\]${CUSTOM_NAME}\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ "; fi' >> /home/user/.bashrc

RUN echo "shell /bin/bash" >> /home/user/.screenrc
RUN echo "source /home/user/.bashrc" >> /home/user/.screenrc

# --- Load Geant4 env automatically ---
RUN echo "source /opt/geant4/bin/geant4.sh" >> /home/user/.bashrc

WORKDIR /mnt/geant4

CMD ["/bin/bash"]